{
  "schema": "nur.kernel-policy/v1",
  "description": "NUR kernel configuration policy (docs/KERNEL_POLICY.md). 'required' options must be y or m or the image build fails; 'recommended' deviations are reported in the build record; 'forbidden_in_release' must be unset for release kernels (Phase 1 builds dev only and reports them).",
  "required": {
    "CONFIG_EFI_STUB": ["y"],
    "CONFIG_BLK_DEV_DM": ["y", "m"],
    "CONFIG_DM_VERITY": ["y", "m"],
    "CONFIG_DM_CRYPT": ["y", "m"],
    "CONFIG_CRYPTO_XTS": ["y", "m"],
    "CONFIG_EROFS_FS": ["y", "m"],
    "CONFIG_EXT4_FS": ["y", "m"],
    "CONFIG_TCG_TPM": ["y", "m"],
    "CONFIG_TCG_TIS": ["y", "m"],
    "CONFIG_TCG_CRB": ["y", "m"],
    "CONFIG_SECURITY_LOCKDOWN_LSM": ["y"],
    "CONFIG_MODULE_SIG": ["y"],
    "CONFIG_SECCOMP": ["y"],
    "CONFIG_SECCOMP_FILTER": ["y"],
    "CONFIG_SECURITY_LANDLOCK": ["y"],
    "CONFIG_SECURITY_YAMA": ["y"],
    "CONFIG_NAMESPACES": ["y"],
    "CONFIG_USER_NS": ["y"],
    "CONFIG_PID_NS": ["y"],
    "CONFIG_NET_NS": ["y"],
    "CONFIG_CGROUPS": ["y"],
    "CONFIG_MEMCG": ["y"],
    "CONFIG_RANDOMIZE_BASE": ["y"],
    "CONFIG_STACKPROTECTOR_STRONG": ["y"],
    "CONFIG_HARDENED_USERCOPY": ["y"],
    "CONFIG_STRICT_DEVMEM": ["y"],
    "CONFIG_KEXEC_SIG": ["y"]
  },
  "recommended": {
    "CONFIG_MODULE_SIG_FORCE": ["y"],
    "CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY": ["y"],
    "CONFIG_INIT_ON_ALLOC_DEFAULT_ON": ["y"],
    "CONFIG_BPF_UNPRIV_DEFAULT_OFF": ["y"],
    "CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG": ["y"],
    "CONFIG_IO_STRICT_DEVMEM": ["y"],
    "CONFIG_IMA": ["y"],
    "CONFIG_EVM": ["y"]
  },
  "forbidden_in_release": ["CONFIG_DEBUG_FS", "CONFIG_KALLSYMS_ALL", "CONFIG_DEVMEM"]
}
